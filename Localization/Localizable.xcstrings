    "MyMole Support" : {},
    "MyMole Website" : {},
    "MyMole can uninstall itself, including the data you choose." : {},
    "MyMole couldn't keep access to that folder." : {},
    "MyMole couldn't read %@%@, so this may not be everything. " : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
