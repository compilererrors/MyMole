<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Required for the Mac App Store. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- Read and write the folders the user chooses: home, Applications, the startup disk. -->
	<key>com.apple.security.files.user-selected.read-write</key>
	<true/>
	<!-- Keep that access across launches as security-scoped bookmarks. -->
	<key>com.apple.security.files.bookmarks.app-scope</key>
	<true/>
	<!-- Downloads without asking, for installers left there. -->
	<key>com.apple.security.files.downloads.read-write</key>
	<true/>
</dict>
</plist>
